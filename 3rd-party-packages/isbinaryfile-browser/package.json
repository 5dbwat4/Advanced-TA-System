{
  "name": "isbinaryfile-browser",
  "version": "6.0.0",
  "description": "Browser port of isbinaryfile 6.0.0: detect whether a Uint8Array is binary. No Node.js dependencies, ESM, TypeScript types included.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "text",
    "binary",
    "encoding",
    "istext",
    "is text",
    "isbinary",
    "is binary",
    "is text or binary",
    "is text or binary file",
    "isbinaryfile",
    "is binary file",
    "istextfile",
    "is text file",
    "browser",
    "uint8array"
  ],
  "license": "MIT"
}
